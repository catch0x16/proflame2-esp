{
  "domain": "proflame2",
  "name": "ProFlame 2 Fireplace Control",
  "documentation": "https://github.com/j2deen/proflame2-esp",
  "dependencies": ["remote_transmitter","switch","number"],
  "codeowners": ["@j2deen"],
  "requirements": [],
  "version": "2.1.0",
  "author": "Jay Deen",
  "license": "MIT",
  "description": "Control ProFlame 2 fireplace systems using ESP32, ESPHome's cc1101 component and remote_transmitter",
  "hardware": {
    "supported": ["ESP32"],
    "required": ["CC1101 RF Module (315 MHz capable), GDO0 wired to the remote_transmitter pin"]
  },
  "features": [
    "Power on/off control",
    "Flame height adjustment (0-6 levels)",
    "Fan speed control (0-6 levels)",
    "Light level control (0-6 levels)",
    "IPI/CPI pilot mode selection",
    "Auxiliary power control",
    "Home Assistant integration",
    "Web interface",
    "MQTT support"
  ],
  "config_schema": {
    "transmitter_id": "optional (the remote_transmitter keying CC1101 GDO0)",
    "serial_number": "required",
    "checksum_c1": "device specific (see README)",
    "checksum_d1": "device specific (see README)",
    "checksum_c2": "device specific (see README)",
    "checksum_d2": "device specific (see README)",
    "power": "optional",
    "pilot": "optional",
    "aux": "optional",
    "front": "optional",
    "thermostat": "optional",
    "flame": "optional",
    "fan": "optional",
    "light": "optional"
  }
}
